# PromptForge runs with zero environment variables out of the box: with
# nothing set below, it stays in the Phase 1–6 demo mode — "signing in"
# opens a local demo account (src/lib/demo-auth.ts), data lives in
# localStorage, and the AI assist panel uses a local simulation.
#
# Set the Supabase variables to switch on real accounts + persistence.
# Set GROQ_API_KEY to switch on real AI assist calls. Each is
# independent — you can turn on one without the other.

# --- Supabase (real auth + persistence) -------------------------------------
# Create a project at https://supabase.com, run supabase/schema.sql in its
# SQL editor, then copy these from Project Settings -> API.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
#
# "Continue with Google" (login/signup pages) needs the Google provider
# turned on in Supabase: Authentication -> Providers -> Google, with a
# Google Cloud OAuth client ID/secret. Add
# https://your-project.supabase.co/auth/v1/callback as an authorized
# redirect URI on the Google Cloud OAuth client. No separate env var is
# needed here — it's config on the Supabase project, not this app.

# Only needed for admin/server-side scripts that must bypass row-level
# security (e.g. a one-off data migration). The app itself never uses this
# — never expose it to the browser (no NEXT_PUBLIC_ prefix, on purpose).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI provider (real Improve/Rewrite/Expand/Shorten) ----------------------
# Server-only — used by src/app/api/ai/route.ts, never sent to the browser.
# Get free keys at https://console.groq.com. Uses llama-3.1-8b-instant.
#
# Set just one key to get started:
# GROQ_API_KEY=your-groq-api-key
#
# For automatic fallback across multiple keys (e.g. so a per-key daily rate
# limit doesn't take AI assist down), set up to 5 numbered keys instead.
# If a key hits its limit (HTTP 429) or is rejected, the request instantly
# retries with the next one — no code changes needed, just add more keys:
# GROQ_API_KEY_1=your-first-groq-api-key
# GROQ_API_KEY_2=your-second-groq-api-key
# GROQ_API_KEY_3=your-third-groq-api-key
# GROQ_API_KEY_4=your-fourth-groq-api-key
# GROQ_API_KEY_5=your-fifth-groq-api-key

# --- Forge AI (the floating chat panel) --------------------------------------
# Server-only — used by src/app/api/forge-ai/route.ts, never sent to the
# browser. Deliberately a SEPARATE key pool from GROQ_API_KEY_* above, so
# Forge AI's chat traffic is independent of Improve/Rewrite/Expand/Shorten/
# Critique — configure one without affecting the other. Same shape: one key,
# or up to 5 for automatic fallback.
# FORGE_AI_GROQ_API_KEY=your-groq-api-key
#
# FORGE_AI_GROQ_API_KEY_1=your-first-groq-api-key
# FORGE_AI_GROQ_API_KEY_2=your-second-groq-api-key
# FORGE_AI_GROQ_API_KEY_3=your-third-groq-api-key
# FORGE_AI_GROQ_API_KEY_4=your-fourth-groq-api-key
# FORGE_AI_GROQ_API_KEY_5=your-fifth-groq-api-key

# --- CodeForge (the /codeforge product: 9 tools + AI Coding Chat) -----------
# Server-only — used by src/app/api/codeforge/route.ts, never sent to the
# browser. Deliberately a SEPARATE key pool from GROQ_API_KEY_* and
# FORGE_AI_GROQ_API_KEY_* above — CodeForge's traffic (Generate Code, Fix
# Bugs, Optimize Code, Explain Code, Convert Languages, Generate Unit Tests,
# Generate Documentation, Review Code, and the AI Coding Chat) never shares
# or competes with PromptForge's or Forge AI's keys/quota. Same shape, but
# 7 slots instead of 5, since one product now fans out across nine tools.
# Set just one key to get started:
# CODEFORGE_GROQ_API_KEY=your-groq-api-key
#
# Or up to 7 for automatic fallback — if a key hits its limit (HTTP 429) or
# is rejected, the request instantly retries with the next one:
# CODEFORGE_GROQ_API_KEY_1=your-first-groq-api-key
# CODEFORGE_GROQ_API_KEY_2=your-second-groq-api-key
# CODEFORGE_GROQ_API_KEY_3=your-third-groq-api-key
# CODEFORGE_GROQ_API_KEY_4=your-fourth-groq-api-key
# CODEFORGE_GROQ_API_KEY_5=your-fifth-groq-api-key
# CODEFORGE_GROQ_API_KEY_6=your-sixth-groq-api-key
# CODEFORGE_GROQ_API_KEY_7=your-seventh-groq-api-key

# --- StudyForge (the /studyforge product: 8 tools + AI Study Chat) ----------
# Server-only — used by src/app/api/studyforge/route.ts, never sent to the
# browser. Deliberately a SEPARATE key pool from every pool above — StudyForge's
# traffic (Explain Concepts, Notes Generator, Flashcards, Quiz Generator,
# Homework Helper, Study Planner, Notes Summarizer, Exam Practice, and the AI
# Study Chat) never shares or competes with PromptForge's, Forge AI's, or
# CodeForge's keys/quota. Same shape, but 10 slots.
# Set just one key to get started:
# STUDYFORGE_GROQ_API_KEY=your-groq-api-key
#
# Or up to 10 for automatic fallback — if a key hits its limit (HTTP 429) or
# is rejected, the request instantly retries with the next one:
# STUDYFORGE_GROQ_API_KEY_1=your-first-groq-api-key
# STUDYFORGE_GROQ_API_KEY_2=your-second-groq-api-key
# STUDYFORGE_GROQ_API_KEY_3=your-third-groq-api-key
# STUDYFORGE_GROQ_API_KEY_4=your-fourth-groq-api-key
# STUDYFORGE_GROQ_API_KEY_5=your-fifth-groq-api-key
# STUDYFORGE_GROQ_API_KEY_6=your-sixth-groq-api-key
# STUDYFORGE_GROQ_API_KEY_7=your-seventh-groq-api-key
# STUDYFORGE_GROQ_API_KEY_8=your-eighth-groq-api-key
# STUDYFORGE_GROQ_API_KEY_9=your-ninth-groq-api-key
# STUDYFORGE_GROQ_API_KEY_10=your-tenth-groq-api-key

# --- PPTForge (the /pptforge product: topic -> downloadable .pptx) ----------
# Server-only — used by src/app/api/pptforge/route.ts, never sent to the
# browser. Its own key pool, same shape as the others (5 slots), but with a
# twist: if no PPTFORGE_GROQ_API_KEY_* is set, it automatically FALLS BACK
# to the shared GROQ_API_KEY_* pool above (see getPptForgeApiKeys in
# src/lib/supabase/config.ts) — so PPTForge still works out of the box in
# an install that already has GROQ_API_KEY configured, with zero extra
# setup. It only falls back that direction, never the reverse: setting
# PPTFORGE_GROQ_API_KEY_* keeps PPTForge's traffic/quota fully independent
# of GROQ_API_KEY_* (and of Forge AI's/CodeForge's/StudyForge's pools)
# whenever you want it to be.
# Set just one key to get started:
# PPTFORGE_GROQ_API_KEY=your-groq-api-key
#
# Or up to 5 for automatic fallback — if a key hits its limit (HTTP 429) or
# is rejected, the request instantly retries with the next one:
# PPTFORGE_GROQ_API_KEY_1=your-first-groq-api-key
# PPTFORGE_GROQ_API_KEY_2=your-second-groq-api-key
# PPTFORGE_GROQ_API_KEY_3=your-third-groq-api-key
# PPTFORGE_GROQ_API_KEY_4=your-fourth-groq-api-key
# PPTFORGE_GROQ_API_KEY_5=your-fifth-groq-api-key
#
# Leave all of the above unset and PPTForge will transparently reuse
# whichever GROQ_API_KEY / GROQ_API_KEY_1.._5 you've already configured.

# --- Gemini (attachment/multimodal provider) --------------------------------
# Server-only — used by src/lib/server/gemini.ts, never sent to the browser.
# Normal text-only chat in Forge AI / AI Coding Chat / AI Study Chat keeps
# using each product's own Groq pool above, exactly as before. The moment a
# chat turn carries an attachment (image, PDF, DOCX, ZIP, or another
# document), that one request is routed to Gemini instead — it can actually
# read those file types natively (PDF text/tables/charts/layout, real ZIP
# contents for code review, etc.) rather than a flattened text extraction
# plus a single vision model.
#
# Get free keys at https://aistudio.google.com/apikey.
#
# Set just one key to get started:
# GEMINI_API_KEY=your-gemini-api-key
#
# Or up to 7 for automatic fallback — one shared pool across all three
# products, since attachment traffic is comparatively rare next to normal
# chat traffic. If a key hits its rate limit/quota (or is invalid), the
# request instantly retries with the next one; a permanent failure (e.g. an
# unsupported file or malformed request) is NOT retried across every key,
# since it would fail identically on all of them:
# GEMINI_API_KEY_1=your-first-gemini-api-key
# GEMINI_API_KEY_2=your-second-gemini-api-key
# GEMINI_API_KEY_3=your-third-gemini-api-key
# GEMINI_API_KEY_4=your-fourth-gemini-api-key
# GEMINI_API_KEY_5=your-fifth-gemini-api-key
# GEMINI_API_KEY_6=your-sixth-gemini-api-key
# GEMINI_API_KEY_7=your-seventh-gemini-api-key
#
# If GEMINI_API_KEY_* isn't set at all, attachments still work in reduced
# form: images fall back to each product's Groq vision model, and PDF/DOCX/
# ZIP attachments fall back to local text extraction (pdf-parse/mammoth/
# jszip) instead of Gemini actually reading the document — see
# src/lib/server/attachment-extract.ts. Large attachments (roughly over 4 MB)
# require Gemini to be configured, since that's what the Files API upload
# path (src/app/api/gemini-upload/route.ts) uploads to.
#
# Daily request budget assumed per Gemini key for the admin dashboard's
# quota/progress-bar display (same purpose as GROQ_DAILY_LIMIT_PER_KEY
# below, just for the Gemini pool). Purely a display estimate. Defaults to
# 1500 if unset.
# GEMINI_DAILY_LIMIT_PER_KEY=1500

# --- Voice Mode (real-time Gemini Live API voice chat) ----------------------
# Server-only — used by src/app/api/voice-token/route.ts, never sent to the
# browser. Deliberately a SEPARATE key pool from GEMINI_API_KEY_* above (the
# attachment/multimodal text provider) — Live API sessions are long-lived
# WebSocket connections with different quota/concurrency behavior than
# one-shot attachment requests, so they never share or compete for quota.
#
# These keys are NEVER exposed to the browser directly. The server uses one
# to mint a short-lived ephemeral token (Gemini's authTokens.create, locked
# to gemini-3.1-flash-live-preview) and hands only that token to the client,
# which then opens its own direct WebSocket session to Gemini for audio.
# Get free keys at https://aistudio.google.com/apikey.
#
# Set just one key to get started:
# GEMINI_VOICE_API_KEY=your-gemini-api-key
#
# Or up to 12 for automatic fallback — if a key hits its rate limit/quota (or
# is invalid), token minting instantly retries with the next one. This
# fallback covers both minting a token AND opening the actual voice
# connection: a key that mints a token fine but turns out to be out of
# Live-session quota once the call connects triggers the same rotation,
# retrying with a fresh key rather than dropping the call:
# GEMINI_VOICE_API_KEY_1=your-first-gemini-api-key
# GEMINI_VOICE_API_KEY_2=your-second-gemini-api-key
# GEMINI_VOICE_API_KEY_3=your-third-gemini-api-key
# GEMINI_VOICE_API_KEY_4=your-fourth-gemini-api-key
# GEMINI_VOICE_API_KEY_5=your-fifth-gemini-api-key
# GEMINI_VOICE_API_KEY_6=your-sixth-gemini-api-key
# GEMINI_VOICE_API_KEY_7=your-seventh-gemini-api-key
# GEMINI_VOICE_API_KEY_8=your-eighth-gemini-api-key
# GEMINI_VOICE_API_KEY_9=your-ninth-gemini-api-key
# GEMINI_VOICE_API_KEY_10=your-tenth-gemini-api-key
# GEMINI_VOICE_API_KEY_11=your-eleventh-gemini-api-key
# GEMINI_VOICE_API_KEY_12=your-twelfth-gemini-api-key
#
# If none of these are set, the Voice tab still shows up but explains that
# Voice Mode isn't configured yet instead of erroring.

# --- Admin dashboard ----------------------------------------------------------
# Comma-separated allowlist of account emails that can access /dashboard/admin,
# in addition to any account with profiles.is_admin = true in Supabase. Works
# in demo mode too (matched against the demo account email).
# ADMIN_EMAILS=you@example.com,teammate@example.com
#
# Daily request budget assumed per Groq key for the admin dashboard's quota /
# progress-bar display. Purely a display estimate — Groq is still the source
# of truth for actual rate limiting. Defaults to 14400 (Groq's free-tier
# llama-3.1-8b-instant per-day request limit) if unset.
# GROQ_DAILY_LIMIT_PER_KEY=14400

# --- Misc --------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
